# Copy to .env.local and fill in. NEVER commit real values.

# Neon Postgres: pooled URL for the app, direct URL for Prisma CLI
DATABASE_URL=
DIRECT_URL=

# Auth.js + Google OAuth (Phase 2)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
